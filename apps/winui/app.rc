101 ICON "ExtraPane.ico"
#include <windows.h>
#include "ExtraPaneVersion.h"
1 VERSIONINFO
FILEVERSION EXTRAPANE_VERSION_NUM
PRODUCTVERSION EXTRAPANE_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "ExtraPane"
      VALUE "FileDescription", "ExtraPane"
      VALUE "FileVersion", EXTRAPANE_VERSION
      VALUE "ProductVersion", EXTRAPANE_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
