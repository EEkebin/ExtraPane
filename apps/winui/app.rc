101 ICON "SideScreen.ico"
#include <windows.h>
#include "SideScreenVersion.h"
1 VERSIONINFO
FILEVERSION SIDESCREEN_VERSION_NUM
PRODUCTVERSION SIDESCREEN_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "SideScreen"
      VALUE "FileDescription", "SideScreen"
      VALUE "FileVersion", SIDESCREEN_VERSION
      VALUE "ProductVersion", SIDESCREEN_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
