* text=auto

# Source and docs: LF everywhere so hashes, diffs and cross-platform builds agree.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.mm text eol=lf
*.m text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.qml text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.desktop text eol=lf
*.in text eol=lf

# Windows-only scripts and installers keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
*.inf text eol=crlf
*.rc text eol=crlf
*.vcxproj text eol=crlf
gradlew.bat text eol=crlf

# Byte-exact files: the build verifies these by SHA-256, so Git must never
# rewrite their line endings (autocrlf did, and broke installer packaging).
*.patch -text
*.diff -text

# Binaries.
*.png binary
*.ico binary
*.jpg binary
*.jar binary
*.cer binary
*.der binary
*.p12 binary
*.tar binary
*.zip binary
