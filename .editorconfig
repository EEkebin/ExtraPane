root = true

# UTF-8 everywhere: UI text with "·", "—" or "›" was once saved in another
# encoding and turned into "?".
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,cmd,bat,iss,inf,rc,vcxproj}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
