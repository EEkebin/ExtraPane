include_guard(GLOBAL)
include(FetchContent)
get_filename_component(DM_ACCESS_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
function(dm_access_dependency)
  set(BUILD_TESTING OFF)
  set(BUILD_SHARED_LIBS OFF)
  set(OPENSSL_NO_ASM ON)
  set(BORINGSSL_PREFIX EXTRAPANE)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
  set(fetch_options)
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
    list(APPEND fetch_options DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  endif()
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
    list(APPEND fetch_options EXCLUDE_FROM_ALL)
  endif()
  FetchContent_Declare(boringssl
    URL https://codeload.github.com/google/boringssl/tar.gz/fd0ed4d0a1273570612a08a31bace08e4dd73c81
    URL_HASH SHA256=ea357dadb94a4973d8d910acf9cac0a61b27a557adaf114f26cbfd0365e2b5b4
    ${fetch_options})
  FetchContent_MakeAvailable(boringssl)
endfunction()
dm_access_dependency()
add_library(dm_access STATIC "${DM_ACCESS_ROOT}/core/access/access.cpp" "${DM_ACCESS_ROOT}/core/access/peer_auth.cpp")
set_target_properties(dm_access PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(dm_access PUBLIC "${DM_ACCESS_ROOT}/core/access/include")
target_compile_features(dm_access PUBLIC cxx_std_20)
target_compile_definitions(dm_access PRIVATE BORINGSSL_PREFIX=EXTRAPANE)
target_link_libraries(dm_access PRIVATE crypto)

option(EXTRAPANE_PEER_AUTH_TESTS "Build peer authentication checks" OFF)
if(EXTRAPANE_PEER_AUTH_TESTS)
 enable_testing()
 add_executable(peers_auth_check "${DM_ACCESS_ROOT}/tests/peers_auth_check.cpp")
 target_link_libraries(peers_auth_check PRIVATE dm_access)
 add_test(NAME peers_auth_check COMMAND peers_auth_check)
 set_tests_properties(peers_auth_check PROPERTIES TIMEOUT 30)
endif()
