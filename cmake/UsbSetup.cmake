set(EXTRAPANE_USBIP_INSTALLER "${CMAKE_SOURCE_DIR}/out/usb-components/USBip-0.9.8.1-x64.exe" CACHE FILEPATH "Pinned USBip backend installer")
if(NOT EXISTS "${EXTRAPANE_USBIP_INSTALLER}")
  message(FATAL_ERROR "Download the pinned USBip 0.9.8.1 x64 installer to EXTRAPANE_USBIP_INSTALLER; configuration never downloads or installs it")
endif()
file(SHA256 "${EXTRAPANE_USBIP_INSTALLER}" usbip_sha)
if(NOT usbip_sha STREQUAL "38cad6d4432b52d5bb9409d9ad03b72fdffc4ada4cd3a48fbeca1a2752a8518a")
  message(FATAL_ERROR "USBip installer SHA256 mismatch")
endif()
file(TO_CMAKE_PATH "${EXTRAPANE_USBIP_INSTALLER}" usbip_payload)
set(usbip_rc "${CMAKE_CURRENT_BINARY_DIR}/usb_setup_payload.rc")
file(WRITE "${usbip_rc}" "101 RCDATA \"${usbip_payload}\"\n")
add_executable(extrapane_usb_setup "${CMAKE_CURRENT_LIST_DIR}/../apps/usb-setup/main.cpp" "${usbip_rc}")
target_compile_features(extrapane_usb_setup PRIVATE cxx_std_20)
target_compile_definitions(extrapane_usb_setup PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(extrapane_usb_setup PRIVATE bcrypt advapi32 shell32 ole32 wintrust crypt32 version)
set_target_properties(extrapane_usb_setup PROPERTIES OUTPUT_NAME "ExtraPane.UsbSetup")
if(EXTRAPANE_RESOURCE_SECURITY_TESTS)
  add_executable(extrapane-usb-setup-check "${CMAKE_CURRENT_LIST_DIR}/../tests/usb_setup_check.cpp")
  target_compile_features(extrapane-usb-setup-check PRIVATE cxx_std_20)
  add_test(NAME usb-setup-policy COMMAND extrapane-usb-setup-check)
  add_test(NAME usb-setup-payload COMMAND extrapane_usb_setup --check-package)
endif()
