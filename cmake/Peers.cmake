include_guard(GLOBAL)
get_filename_component(EXTRAPANE_PEER_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(extrapane_peer_transport STATIC "${EXTRAPANE_PEER_ROOT}/core/peers/transport.cpp")
target_include_directories(extrapane_peer_transport PUBLIC "${EXTRAPANE_PEER_ROOT}/core/peers/include")
target_compile_features(extrapane_peer_transport PUBLIC cxx_std_20)
target_compile_definitions(extrapane_peer_transport PRIVATE BORINGSSL_PREFIX=EXTRAPANE)
target_link_libraries(extrapane_peer_transport PRIVATE ssl crypto)
if(WIN32)
  target_compile_definitions(extrapane_peer_transport PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  target_link_libraries(extrapane_peer_transport PRIVATE ws2_32)
endif()
option(EXTRAPANE_PEER_TRANSPORT_TESTS "Build isolated peer TLS transport checks" OFF)
if(EXTRAPANE_PEER_TRANSPORT_TESTS)
  enable_testing()
  add_executable(extrapane-peer-transport-check "${EXTRAPANE_PEER_ROOT}/tests/peer_transport_check.cpp")
  target_link_libraries(extrapane-peer-transport-check PRIVATE extrapane_peer_transport)
  add_test(NAME peer-transport-loopback COMMAND extrapane-peer-transport-check)
endif()
add_library(extrapane_peer_session STATIC "${EXTRAPANE_PEER_ROOT}/core/peers/session.cpp")
target_include_directories(extrapane_peer_session PUBLIC "${EXTRAPANE_PEER_ROOT}/core/peers/include")
