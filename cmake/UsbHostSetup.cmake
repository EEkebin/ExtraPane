set(EXTRAPANE_USB_HOST_PAYLOAD "${CMAKE_SOURCE_DIR}/out/usb-host/publish" CACHE PATH "Pinned patched native USB host publication")
set(usb_host_files usbipd.exe usb.ids EventManifest.xml COPYING.md Drivers/VBoxUSB.inf Drivers/VBoxUSB.cat Drivers/VBoxUSB.sys Drivers/VBoxUSBMon.sys)
set(usb_host_pin "4431eba52a2de9f21e3a4ba1f7dc1e408cd57019")
set(usb_host_generated "${CMAKE_CURRENT_BINARY_DIR}/usb-host-setup")
file(MAKE_DIRECTORY "${usb_host_generated}")
set(usb_host_rc "")
set(usb_host_header "#pragma once\n#include <array>\nnamespace extrapane::usb_host_setup {\nstruct File{const wchar_t* name;const wchar_t* digest;unsigned resource;};\ninline constexpr wchar_t source[]=L\"${usb_host_pin}\";\ninline constexpr std::array<File,8> files{{\n")
set(usb_host_index 101)
foreach(file IN LISTS usb_host_files)
  set(path "${EXTRAPANE_USB_HOST_PAYLOAD}/${file}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing USB host payload ${path}; run scripts/build-usb-host.ps1 -Publish first. Setup never downloads or installs while building.")
  endif()
  file(SHA256 "${path}" sha)
  file(TO_CMAKE_PATH "${path}" resource_path)
  string(APPEND usb_host_rc "${usb_host_index} RCDATA \"${resource_path}\"\n")
  string(APPEND usb_host_header "{L\"${file}\",L\"${sha}\",${usb_host_index}},\n")
  math(EXPR usb_host_index "${usb_host_index}+1")
endforeach()
string(APPEND usb_host_header "}};\n}\n")
file(WRITE "${usb_host_generated}/usb_host_payload.hpp" "${usb_host_header}")
file(WRITE "${usb_host_generated}/payload.rc" "${usb_host_rc}")
add_executable(extrapane_usb_host_setup apps/usb-host-setup/main.cpp "${usb_host_generated}/payload.rc")
target_include_directories(extrapane_usb_host_setup PRIVATE "${usb_host_generated}")
target_compile_features(extrapane_usb_host_setup PRIVATE cxx_std_20)
target_compile_definitions(extrapane_usb_host_setup PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(extrapane_usb_host_setup PRIVATE bcrypt advapi32 shell32 ole32 wintrust crypt32 setupapi)
set_target_properties(extrapane_usb_host_setup PROPERTIES OUTPUT_NAME "ExtraPane.UsbHostSetup")
if(EXTRAPANE_RESOURCE_SECURITY_TESTS)
  add_executable(extrapane-usb-monitor-policy-check tests/usb_monitor_policy_check.cpp)
  target_compile_features(extrapane-usb-monitor-policy-check PRIVATE cxx_std_20)
  add_test(NAME usb-monitor-policy COMMAND extrapane-usb-monitor-policy-check)
  add_test(NAME usb-host-setup-payload COMMAND extrapane_usb_host_setup --check-package)
endif()
