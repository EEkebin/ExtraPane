# Source capture only: does not install a recording endpoint or touch devices.
add_library(dm_microphone_pcm STATIC platform/windows/microphone_pcm.cpp)
target_include_directories(dm_microphone_pcm PUBLIC platform/windows/include)
target_compile_features(dm_microphone_pcm PUBLIC cxx_std_20)
if(WIN32)
  add_library(dm_microphone STATIC platform/windows/microphone.cpp)
  target_link_libraries(dm_microphone PUBLIC dm_microphone_pcm PRIVATE ole32 uuid)
  target_compile_features(dm_microphone PUBLIC cxx_std_20)
endif()
option(EXTRAPANE_MICROPHONE_TESTS "Build pure microphone PCM conversion checks (no capture)" OFF)
if(EXTRAPANE_MICROPHONE_TESTS)
  enable_testing()
  add_executable(extrapane-microphone-check tests/microphone_check.cpp)
  target_link_libraries(extrapane-microphone-check PRIVATE dm_microphone_pcm)
  add_test(NAME microphone-pcm COMMAND extrapane-microphone-check)
endif()
